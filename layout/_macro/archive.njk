{% from "_macro/ui.njk" import icon_nav_arrow with context %}

{# Single archive entry: date + linked title. Shared by both list macros below. #}
{% macro archive_item(post) %}
{% set post_date_attr = date(post.date, 'YYYY-MM-DD') %}
{% set post_date_text = date(post.date, 'YYYY/MM/DD') %}
<article class="group flex items-baseline gap-6">
    <time datetime="{{ escape_attr(post_date_attr) }}" class="w-24 shrink-0 text-right text-sm font-medium text-slate-400 oldstyle-nums">
        {{ post_date_text }}
    </time>
    <h3 class="text-base font-normal text-slate-700 transition-colors group-hover:text-seal">
        <a href="{{ href_for(post.path) }}" class="link-underline">{{ escape_html(post.title) }}</a>
    </h3>
</article>
{% endmacro %}

{% macro render_list(posts) %}
    <div class="space-y-16 max-w-2xl mx-auto">
        {% set currentYear = '' %}
        {% for post in posts.toArray() %}
            {% set y = date(post.date, 'YYYY') %}
            {% if y != currentYear %}
                {% if currentYear != '' %}
                </div>{# close .space-y-4 #}
                </div>{# close .relative #}
                {% endif %}
                {% set currentYear = y %}
                <div class="relative">{# year group wrapper — closed when year changes or after loop #}
                <h2 class="section-heading">
                    {{ icon_nav_arrow() }}
                    {{ y }}
                </h2>
                <div class="space-y-4">
            {% endif %}
            {{ archive_item(post) }}
        {% endfor %}
        {% if currentYear != '' %}
            </div>{# close .space-y-4 #}
            </div>{# close .relative #}
        {% endif %}
    </div>
{% endmacro %}

{# limit > 0: only the first N posts (category cloud / previews). #}
{% macro render_simple_list(posts, limit=0) %}
    <div class="space-y-4">
        {% set items = posts.toArray() if posts else [] %}
        {% for post in items %}
            {% if limit <= 0 or loop.index <= limit %}
            {{ archive_item(post) }}
            {% endif %}
        {% endfor %}
    </div>
{% endmacro %}

