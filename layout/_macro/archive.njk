{% from "_macro/ui.njk" import icon_nav_arrow with context %}

{# Single archive entry: date + linked title. Shared by both list macros below. #}
{% macro archive_item(post) %}
{% set post_date_attr = date(post.date, 'YYYY-MM-DD') %}
{% set post_date_text = date(post.date, 'YYYY/MM/DD') %}
<article class="group flex items-baseline gap-6">
    <time datetime="{{ escape_attr(post_date_attr) }}" class="w-24 shrink-0 text-right text-sm text-text-chrome oldstyle-nums">
        {{ escape_html(post_date_text) }}
    </time>
    <h3 class="text-base font-normal text-text-body transition-colors group-hover:text-seal">
        <a href="{{ href_for(post.path) }}" class="link-underline">{{ escape_html(post.title) }}</a>
    </h3>
</article>
{% endmacro %}

{% macro render_list(posts) %}
    <div class="space-y-16 max-w-2xl mx-auto">
        {% for group in posts_by_year(posts) %}
        <div class="relative">
            <h2 class="section-heading">
                {{ icon_nav_arrow() }}
                {% if group.year %}
                {# Yearly archive page (same helper as post meta date links). #}
                <a href="{{ attr_url(archive_url(group.year)) }}"
                    class="section-heading-link oldstyle-nums">{{ escape_html(group.year) }}</a>
                {% endif %}
            </h2>
            <div class="space-y-4">
                {% for post in group.posts %}
                {{ archive_item(post) }}
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </div>
{% endmacro %}

{# limit > 0: only the first N posts (category cloud / previews).
   Accepts a Hexo Query (toArray) or a plain array (already sliced). #}
{% macro render_simple_list(posts, limit=0) %}
    <div class="space-y-4">
        {% if posts and posts.toArray %}
        {% set items = posts.toArray() %}
        {% else %}
        {% set items = posts if posts else [] %}
        {% endif %}
        {% for post in items %}
            {% if limit <= 0 or loop.index <= limit %}
            {{ archive_item(post) }}
            {% endif %}
        {% endfor %}
    </div>
{% endmacro %}
