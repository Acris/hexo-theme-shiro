{% macro meta(post, show_all_cats=false, class="mt-2") %}
{% set post_year = date(post.date, 'YYYY') %}
{% set post_date_attr = date(post.date, 'YYYY-MM-DD') %}
{% set post_date_text = date(post.date, 'YYYY/MM/DD') %}
<div class="{{ html_attr(class) | safe }} flex items-center justify-center gap-4 text-sm text-slate-500 flex-wrap">
    <div class="flex items-center gap-1.5">
        {{ icon_nav_arrow() }}
        <a href="{{ html_attr(url_for('archives/' + post_year) + '/') | safe }}" class="oldstyle-nums link-muted"><time datetime="{{ post_date_attr }}">{{ post_date_text }}</time></a>
    </div>
    {% if post.categories and post.categories.length > 0 %}
        {% set post_categories = post.categories.toArray() %}
        <span class="text-slate-300" aria-hidden="true">•</span>
        <div class="flex items-center gap-1.5">
            {{ icon_folder() }}
            {% if show_all_cats %}
                {% for cat in post_categories %}
                    <a class="link-muted" href="{{ html_attr(url_for(cat.path)) | safe }}">{{ html_attr(cat.name) | safe }}</a>
                    {% if not loop.last %}<span class="text-slate-300">/</span>{% endif %}
                {% endfor %}
            {% else %}
                {% set first_cat = post_categories[0] %}
                <a class="link-muted" href="{{ html_attr(url_for(first_cat.path)) | safe }}">{{ html_attr(first_cat.name) | safe }}</a>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endmacro %}

{% macro render_tag(tag, show_count=false) %}
<a href="{{ html_attr(url_for(tag.path)) | safe }}" class="tag-pill">
    <svg class="size-3 text-slate-400 mr-2 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
        <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
    </svg>
    {{ html_attr(tag.name) | safe }}
    {% if show_count %}
        <span class="text-slate-400 ml-1 text-xs">{{ tag.length }}</span>
    {% endif %}
</a>
{% endmacro %}
