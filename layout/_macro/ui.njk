{% macro meta(post, show_all_cats=false, class="mt-2") %}
{% set post_year = date(post.date, 'YYYY') %}
{% set post_date_attr = date(post.date, 'YYYY-MM-DD') %}
{% set post_date_text = date(post.date, 'YYYY/MM/DD') %}
{% set wc = word_count_meta(post, {
    timeSuffix: __('word_count.time_minutes'),
    countLabel: __('word_count.count'),
    timeLabel: __('word_count.time')
}) %}
{% set meta_dense = wc and (wc.count != null or wc.time != null) %}
{% set meta_icon = "size-3.5 text-text-subtle shrink-0 sm:size-4" if meta_dense else "size-4 text-text-subtle shrink-0" %}
{# ~3 clusters when word count is on (date • category • count/time). Sibling
   bullets + gap-x keep separators visually centered between chips. #}
{# text-chrome: AA-safe idle on dark paper for small meta chips (see DESIGN.md). #}
<div class="{{ escape_attr(class) }} flex flex-wrap items-center justify-center gap-y-1 text-text-chrome {% if meta_dense %}gap-x-3 text-xs sm:gap-x-4 sm:text-sm{% else %}gap-x-4 text-sm{% endif %}">
    <div class="flex items-center gap-1.5">
        {{ icon_nav_arrow(class=meta_icon) }}
        <a href="{{ attr_url(archive_url(post_year)) }}" class="oldstyle-nums link-chrome"><time datetime="{{ escape_attr(post_date_attr) }}">{{ escape_html(post_date_text) }}</time></a>
    </div>
    {% if post.categories and post.categories.length > 0 %}
        {% set post_categories = post.categories.toArray() %}
        <span class="select-none text-text-faint" aria-hidden="true">•</span>
        <div class="flex items-center gap-1.5">
            {{ icon_folder(class=meta_icon) }}
            {% if show_all_cats %}
                {# Article header: full hierarchy / all assigned categories. #}
                {% for cat in post_categories %}
                    <a class="link-chrome" href="{{ href_for(cat.path) }}" title="{{ escape_attr(category_path_label(cat)) }}">{{ escape_html(cat.name) }}</a>
                    {% if not loop.last %}<span class="text-text-faint">/</span>{% endif %}
                {% endfor %}
            {% else %}
                {# List cards: deepest primary + parallel overflow (+N); title lists all topic paths. #}
                {% set cat_meta = post_meta_category(post) %}
                {% if cat_meta and cat_meta.primary %}
                <a class="link-chrome" href="{{ href_for(cat_meta.primary.path) }}" title="{{ escape_attr(cat_meta.title) }}">{{ escape_html(cat_meta.primary.name) }}</a>
                {% if cat_meta.moreCount > 0 %}
                <span class="meta-cat-more oldstyle-nums" title="{{ escape_attr(cat_meta.title) }}">{{ escape_html(__('categories.meta_more', cat_meta.moreCount)) }}</span>
                {% endif %}
                {% endif %}
            {% endif %}
        </div>
    {% endif %}
    {% if meta_dense %}
        <span class="select-none text-text-faint" aria-hidden="true">•</span>
        {# One chip: "1.2k / 5 mins" — slash for sub-fields; bullet for clusters. #}
        <div class="flex items-center gap-1.5 oldstyle-nums"{% if wc.title %} title="{{ escape_attr(wc.title) }}"{% endif %}>
            {{ icon_book(class=meta_icon) }}
            {% if wc.count != null %}
            <span aria-label="{{ escape_attr(__('word_count.count') + ': ' + wc.count) }}">{{ escape_html(wc.count) }}</span>
            {% endif %}
            {% if wc.count != null and wc.time != null %}
            <span class="select-none text-text-faint" aria-hidden="true">/</span>
            {% endif %}
            {% if wc.time != null %}
            <span aria-label="{{ escape_attr(__('word_count.time') + ': ' + wc.time) }}">{{ escape_html(wc.time) }}</span>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endmacro %}

{% macro render_tag(tag, show_count=false) %}
<a href="{{ href_for(tag.path) }}" class="tag-pill">
    <svg class="size-3 text-text-subtle mr-2 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
        <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
    </svg>
    {{ escape_html(tag.name) }}
    {% if show_count %}
        <span class="text-text-chrome ml-1 text-xs">{{ tag.length }}</span>
    {% endif %}
</a>
{% endmacro %}
