{# Shared article structure for post.njk and page.njk.
   Expects: page, theme, and macros (meta, render_tag) to be available in context.
   Variables (set before include):
     - article_show_meta: whether to show date/category meta (default: true)
     - article_extra: extra HTML to insert after tags (e.g. post navigation) #}
{% from "_macro/ui.njk" import meta, render_tag with context %}
{% set article_toc = build_toc(page, theme.toc) %}

<article class="py-2">
    <header class="text-center mb-8">
        <h1 class="page-title mb-4">
            {{ page.title }}
        </h1>
        {% if article_show_meta %}
        {{ meta(page, true, "mb-4") }}
        {% endif %}
    </header>

    {% if article_toc.shouldRender %}
    {% include "_partial/components/toc.njk" %}
    {% endif %}

    <div class="prose-shiro" data-pagefind-body>
        {{ article_toc.content | safe }}
    </div>

    <!-- Tags -->
    {% if page.tags and page.tags.length > 0 %}
    <div class="mt-8 flex flex-wrap gap-2">
        {% for tag in page.tags.toArray() %}
        {{ render_tag(tag, false) }}
        {% endfor %}
    </div>
    {% endif %}

    {{ article_extra | safe }}

    {% set disqus_comments_ready = theme.comments.enabled and theme.comments.provider == "disqus" and theme.comments.disqus.shortname %}
    {% set giscus_comments_ready = theme.comments.enabled and theme.comments.provider == "giscus" and theme.comments.giscus.repo %}
    {% if disqus_comments_ready or giscus_comments_ready %}
    {% include "_partial/comments/bootstrap.njk" %}
    {% endif %}
    {% include "_partial/comments/disqus.njk" %}
    {% include "_partial/comments/giscus.njk" %}
</article>
