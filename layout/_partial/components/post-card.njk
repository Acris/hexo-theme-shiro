{% from "_macro/ui.njk" import meta with context %}
<article class="py-2">
    <header class="text-center mb-4">
        <h2 class="font-bold leading-snug text-slate-900 text-[1.35rem] transition-colors hover:text-seal sm:text-[1.45rem] md:text-[1.6rem]">
            <a href="{{ html_attr(url_for(post.path)) | safe }}">{{ html_attr(post.title) | safe }}</a>
        </h2>
        {{ meta(post) }}
    </header>
    {# When fallback is disabled, pass length 0 so excerpt_for only honors manual <!-- more --> excerpts. #}
    {% set excerpt_config = theme.excerpt or {} %}
    {% set fallback_config = excerpt_config.fallback or {} %}
    {% set fallback_enabled = fallback_config.enabled != false %}
    {% if fallback_enabled %}
    {% set fallback_length = fallback_config.length | default(200) %}
    {% else %}
    {% set fallback_length = 0 %}
    {% endif %}
    {% set excerpt = excerpt_for(post, fallback_length) %}
    <div class="prose-shiro">
        {{ excerpt.content | safe }}
    </div>
    {% if excerpt.truncated %}
    <div class="mt-6 text-center">
        <a href="{{ html_attr(url_for(post.path)) | safe }}"
            class="focus-elegant btn-ink">
            {{ html_attr(__('index.read_more')) | safe }}
        </a>
    </div>
    {% endif %}
</article>
