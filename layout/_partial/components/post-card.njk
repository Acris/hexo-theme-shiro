{% from "_macro/ui.njk" import meta with context %}
<article class="py-2">
    <header class="text-center mb-4">
        <h2 class="font-bold leading-snug text-text-heading text-[1.35rem] transition-colors hover:text-seal sm:text-[1.45rem] md:text-[1.6rem]">
            <a href="{{ href_for(post.path) }}">{{ escape_html(post.title) }}</a>
        </h2>
        {{ meta(post) }}
    </header>
    {# Policy in excerpt_for_card (theme.excerpt.fallback). MathJax is not loaded
       on list pages — formulas in excerpts stay as TeX source. #}
    {% set excerpt = excerpt_for_card(post, first_card) %}
    <div class="prose-shiro">
        {{ excerpt.content | safe }}
    </div>
    {% if excerpt.truncated %}
    <div class="mt-6 text-center">
        <a href="{{ href_for(post.path) }}"
            class="focus-elegant btn-ink"
            aria-label="{{ escape_attr(__('index.read_more') + ': ' + post.title) }}">
            {{ escape_html(__('index.read_more')) }}
        </a>
    </div>
    {% endif %}
</article>
