<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content="Hexo {{ hexo.version }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- FOUC prevention: apply dark mode class before first paint.
         Flow: read default → build valid states → read localStorage (try/catch for Safari private mode)
         → validate saved state → set data-theme-state on <html> → resolve effective dark/light
         → add .dark class and colorScheme if needed. -->
    <script>
    ;(() => {
        const defaultTheme = {{ theme.dark_mode.default | default("system", true) | dump | safe }};
        window.__themeDefault = defaultTheme;
        const states = defaultTheme === 'system' ? ['system', 'light', 'dark'] : ['light', 'dark'];
        let saved;
        try { saved = localStorage.getItem('theme'); } catch (_) {}
        const state = saved && states.includes(saved) ? saved : defaultTheme;
        const html = document.documentElement;
        html.setAttribute('data-theme-state', state);
        const isDark = state === 'dark'
            || (state !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) html.classList.add('dark');
        html.style.colorScheme = isDark ? 'dark' : 'light';
    })();
    </script>
    {% for google_fonts_url in google_font_urls(page, config, theme) %}
    <link rel="stylesheet" href="{{ google_fonts_url }}" />
    {% endfor %}
    {# --- SEO Variables --- #}
    {% set site_title = config.title %}
    {% set page_title = build_page_title(page, config) %}
    {% set clean_desc = clean_description(page, config) %}
    {% set og_img = og_image(page) %}
    {% set page_author = page.author or config.author %}
    {% set keywords = page.keywords %}
    {% if not keywords and page.tags and page.tags.length %}
        {% set keywords %}{% for tag in page.tags.toArray() %}{{ tag.name }}{% if not loop.last %}, {% endif %}{% endfor %}{% endset %}
    {% endif %}
    {% set keywords = keywords or config.keywords %}
    <title>{{ page_title }}</title>

    <!-- SEO Meta -->
    {% if clean_desc %}
    <meta name="description" content="{{ clean_desc }}" />
    {% endif %}
    {% if page_author %}
    <meta name="author" content="{{ page_author }}" />
    {% endif %}
    {% if keywords %}
    <meta name="keywords" content="{{ keywords }}" />
    {% endif %}

    <!-- Open Graph -->
    <meta property="og:title" content="{{ page_title }}" />
    {% if clean_desc %}
    <meta property="og:description" content="{{ clean_desc }}" />
    {% endif %}
    <meta property="og:url" content="{{ url }}" />
    <meta property="og:type" content="{% if is_post() %}article{% else %}website{% endif %}" />
    <meta property="og:site_name" content="{{ site_title }}" />
    {% if og_img %}
    <meta property="og:image" content="{{ og_img }}" />
    {% endif %}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="{% if og_img %}summary_large_image{% else %}summary{% endif %}" />
    <meta name="twitter:title" content="{{ page_title }}" />
    {% if clean_desc %}
    <meta name="twitter:description" content="{{ clean_desc }}" />
    {% endif %}
    {% if og_img %}
    <meta name="twitter:image" content="{{ og_img }}" />
    {% endif %}

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ url }}" />

    <!-- Favicon -->
    {% if theme.site.favicon %}
    <link rel="icon" href="{{ url_for(theme.site.favicon) }}" />
    {% endif %}

    <!-- RSS -->
    {% if theme.site.rss.enabled %}
    <link rel="alternate" type="application/atom+xml" title="{{ config.title }}" href="{{ url_for(theme.site.rss.path | default('/atom.xml')) }}" />
    {% endif %}

    <!-- CSS -->
    {% set needs_code_styles = page_has_code(page, theme) %}
    {% set needs_toc_styles = theme.toc.enabled and (is_post() or is_page()) and should_render_toc(page, theme.toc) %}
    <link rel="stylesheet" href="{{ versioned_url('css/style.min.css') }}">
    {% if needs_code_styles %}
    <link rel="stylesheet" href="{{ versioned_url('css/code.min.css') }}">
    {% endif %}
    {% if needs_toc_styles %}
    <link rel="stylesheet" href="{{ versioned_url('css/toc.min.css') }}">
    {% endif %}
</head>
