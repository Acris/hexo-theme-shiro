<head>
    <meta charset="utf-8" />
    <!-- FOUC prevention: apply dark mode class before first paint -->
    <script>(function(){var d='{{ theme.dark_mode.default | default("system", true) }}';window.__themeDefault=d;var s=d==='system'?['system','light','dark']:['light','dark'];var t=localStorage.getItem('theme');if(!t||s.indexOf(t)===-1)t=d;var h=document.documentElement;h.setAttribute('data-theme-state',t);var k=t==='dark'||(t!=='light'&&window.matchMedia('(prefers-color-scheme:dark)').matches);if(k)h.classList.add('dark');h.style.colorScheme=k?'dark':'light';})()</script>
    <!-- Preconnect for Google Fonts (before any CSS to maximize benefit) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Google Fonts: async preload to avoid render-blocking; merged into a single request.
         Note: onload inline handler may be blocked under strict CSP; use JS font loader if CSP is required. -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cardo:wght@400;700&family=Spectral:wght@400;500;600&family=Yuji+Syuku&family=Zen+Old+Mincho:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600&family=Cormorant+Garamond:wght@400;500;600&family=Fira+Code:wght@400;500;600&display=swap" onload="this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cardo:wght@400;700&family=Spectral:wght@400;500;600&family=Yuji+Syuku&family=Zen+Old+Mincho:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600&family=Cormorant+Garamond:wght@400;500;600&family=Fira+Code:wght@400;500;600&display=swap" /></noscript>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% set site_title = config.title | default("白夜書簡", true) %}
    {% set page_title %}{% if is_home() %}{{ site_title }}{% else %}{{ page.title }} | {{ site_title }}{% endif %}{% endset %}
    <title>{{ page_title }}</title>

    <!-- SEO Meta -->
    {% set clean_desc = clean_description(page, config) %}
    {% if clean_desc %}
    <meta name="description" content="{{ clean_desc }}" />
    {% endif %}
    {% if page.author or config.author %}
    <meta name="author" content="{{ page.author or config.author }}" />
    {% endif %}
    {% if page.keywords %}
    <meta name="keywords" content="{{ page.keywords }}" />
    {% elif page.tags and page.tags.length %}
    <meta name="keywords" content="{% for tag in page.tags.toArray() %}{{ tag.name }}{% if not loop.last %}, {% endif %}{% endfor %}" />
    {% elif config.keywords %}
    <meta name="keywords" content="{{ config.keywords }}" />
    {% endif %}

    <!-- Open Graph -->
    <meta property="og:title" content="{{ page_title }}" />
    {% if clean_desc %}
    <meta property="og:description" content="{{ clean_desc }}" />
    {% endif %}
    <meta property="og:url" content="{{ url }}" />
    <meta property="og:type" content="{% if is_post() %}article{% else %}website{% endif %}" />
    <meta property="og:site_name" content="{{ site_title }}" />
    {% set og_img = og_image(page) %}
    {% if og_img %}
    <meta property="og:image" content="{{ og_img }}" />
    {% endif %}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="{% if og_img %}summary_large_image{% else %}summary{% endif %}" />
    <meta name="twitter:title" content="{{ page_title }}" />
    {% if clean_desc %}
    <meta name="twitter:description" content="{{ clean_desc }}" />
    {% endif %}
    {% if og_img %}
    <meta name="twitter:image" content="{{ og_img }}" />
    {% endif %}

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ url }}" />

    <!-- Favicon -->
    {% if theme.site.favicon %}
    <link rel="icon" href="{{ url_for(theme.site.favicon) }}" />
    {% endif %}

    <!-- RSS -->
    {% if theme.site.rss.enabled %}
    <link rel="alternate" type="application/atom+xml" title="{{ config.title }}" href="{{ url_for(theme.site.rss.path | default('/atom.xml')) }}" />
    {% endif %}

    <!-- CSS -->
    {% if is_home() or is_post() or is_page() %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightgallery@2.9.0/css/lightgallery.min.css" />
    {% endif %}
    <link rel="stylesheet" href="{{ url_for('css/style.min.css') }}">
</head>
