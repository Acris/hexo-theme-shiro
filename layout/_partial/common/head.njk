<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content="Hexo {{ hexo.version }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- FOUC prevention: resolve theme before first paint.
         Flow: read default → build valid states → read localStorage (try/catch for Safari private mode)
         → validate saved state → set data-theme-state on <html> → resolve effective dark/light
         → set data-theme and colorScheme. -->
    <script>
    ;(() => {
        const defaultTheme = {{ js_value(dark_mode_default) | safe }};
        window.__themeDefault = defaultTheme;
        const states = defaultTheme === 'system' ? ['system', 'light', 'dark'] : ['light', 'dark'];
        let saved;
        try { saved = localStorage.getItem('theme'); } catch (_) {}
        const state = saved && states.includes(saved) ? saved : defaultTheme;
        const html = document.documentElement;
        html.setAttribute('data-theme-state', state);
        const isDark = state === 'dark'
            || (state !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        html.setAttribute('data-theme', isDark ? 'dark' : 'light');
        html.style.colorScheme = isDark ? 'dark' : 'light';
    })();
    </script>
    {% for google_fonts_url in google_font_urls(page, config, theme, needs_code) %}
    <link rel="stylesheet" href="{{ html_attr(google_fonts_url) | safe }}" />
    {% endfor %}
    {# --- SEO Variables --- #}
    {% set page_title = build_page_title(page, config) %}
    {% set clean_desc = clean_description(page, config) %}
    {% set og_img = og_image(page) %}
    {% set page_author = page.author or config.author %}
    {% set keywords = page.keywords %}
    {% if not keywords and page.tags and page.tags.length %}
        {% set keywords %}{% for tag in page.tags.toArray() %}{{ tag.name }}{% if not loop.last %}, {% endif %}{% endfor %}{% endset %}
    {% endif %}
    {% set keywords = keywords or config.keywords %}
    <title>{{ html_attr(page_title) | safe }}</title>

    <!-- SEO Meta -->
    {% if clean_desc %}
    <meta name="description" content="{{ html_attr(clean_desc) | safe }}" />
    {% endif %}
    {% if page_author %}
    <meta name="author" content="{{ html_attr(page_author) | safe }}" />
    {% endif %}
    {% if keywords %}
    <meta name="keywords" content="{{ html_attr(keywords) | safe }}" />
    {% endif %}

    <!-- Open Graph -->
    <meta property="og:title" content="{{ html_attr(page_title) | safe }}" />
    {% if clean_desc %}
    <meta property="og:description" content="{{ html_attr(clean_desc) | safe }}" />
    {% endif %}
    <meta property="og:url" content="{{ html_attr(url) | safe }}" />
    <meta property="og:type" content="{% if is_post() %}article{% else %}website{% endif %}" />
    <meta property="og:site_name" content="{{ html_attr(config.title) | safe }}" />
    {% if og_img %}
    <meta property="og:image" content="{{ html_attr(og_img) | safe }}" />
    {% endif %}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="{% if og_img %}summary_large_image{% else %}summary{% endif %}" />
    <meta name="twitter:title" content="{{ html_attr(page_title) | safe }}" />
    {% if clean_desc %}
    <meta name="twitter:description" content="{{ html_attr(clean_desc) | safe }}" />
    {% endif %}
    {% if og_img %}
    <meta name="twitter:image" content="{{ html_attr(og_img) | safe }}" />
    {% endif %}

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ html_attr(url) | safe }}" />

    <!-- Favicon -->
    {% if site_favicon %}
    <link rel="icon" href="{{ html_attr(safe_resource_url_for(site_favicon, '/favicon.svg', true)) | safe }}" />
    {% endif %}

    <!-- RSS -->
    {% set rss_config = site_config.rss or {} %}
    {% if rss_config.enabled %}
    <link rel="alternate" type="application/atom+xml" title="{{ html_attr(config.title) | safe }}" href="{{ html_attr(safe_resource_url_for(rss_config.path | default('/atom.xml'), '/atom.xml')) | safe }}" />
    {% endif %}

    <!-- CSS -->
    <link rel="stylesheet" href="{{ html_attr(versioned_url('css/style.min.css')) | safe }}">
    {% if needs_code %}
    <link rel="stylesheet" href="{{ html_attr(versioned_url('css/code.min.css')) | safe }}">
    {% endif %}
    {% if needs_toc %}
    <link rel="stylesheet" href="{{ html_attr(versioned_url('css/toc.min.css')) | safe }}">
    {% endif %}
</head>
