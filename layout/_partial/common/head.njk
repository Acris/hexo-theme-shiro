<head>
    <meta charset="utf-8" />
    <!-- FOUC prevention: apply dark mode class before first paint -->
    <script>(function(){var d='{{ theme.dark_mode.default | default("system", true) }}';window.__themeDefault=d;var t=localStorage.getItem('theme')||d;var k=t==='dark'||(t!=='light'&&window.matchMedia('(prefers-color-scheme:dark)').matches);if(k)document.documentElement.classList.add('dark');document.documentElement.style.colorScheme=k?'dark':'light';window.__prefersReduced=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;})()</script>
    <!-- Preconnect for Google Fonts (before any CSS to maximize benefit) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Google Fonts: async preload to avoid render-blocking; merged into a single request.
         Note: onload inline handler may be blocked under strict CSP; use JS font loader if CSP is required. -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cardo:wght@400;700&family=Spectral:wght@400;500;600&family=Yuji+Syuku&family=Yuji+Boku&family=Zen+Old+Mincho:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600&family=Shippori+Mincho:wght@400;500;600&family=Cormorant+Garamond:wght@400;500;600&family=Fira+Code:wght@400;500;600&family=IM+Fell+English:ital@0;1&display=swap" onload="this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cardo:wght@400;700&family=Spectral:wght@400;500;600&family=Yuji+Syuku&family=Yuji+Boku&family=Zen+Old+Mincho:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600&family=Shippori+Mincho:wght@400;500;600&family=Cormorant+Garamond:wght@400;500;600&family=Fira+Code:wght@400;500;600&family=IM+Fell+English:ital@0;1&display=swap" /></noscript>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% set site_title = config.title | default("白夜書簡", true) %}
    {% set page_title %}{% if is_home() %}{{ site_title }}{% else %}{{ page.title }} | {{ site_title }}{% endif %}{% endset %}
    <title>{{ page_title }}</title>

    <!-- SEO Meta -->
    {% set meta_description = page.description or page.excerpt or config.description or '' %}
    {% set clean_description = strip_html(meta_description) | truncate(200) %}
    {% if meta_description %}
    <meta name="description" content="{{ clean_description }}" />
    {% endif %}
    {% if page.keywords %}
    <meta name="keywords" content="{{ page.keywords }}" />
    {% elif page.tags and page.tags.length %}
    <meta name="keywords" content="{% for tag in page.tags.toArray() %}{{ tag.name }}{% if not loop.last %}, {% endif %}{% endfor %}" />
    {% elif config.keywords %}
    <meta name="keywords" content="{{ config.keywords }}" />
    {% endif %}

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ url }}" />

    <!-- Favicon -->
    {% if theme.site.favicon %}
    <link rel="icon" href="{{ url_for(theme.site.favicon) }}" />
    {% endif %}

    <!-- RSS -->
    {% if theme.site.rss.enabled %}
    <link rel="alternate" type="application/atom+xml" title="{{ config.title }}" href="{{ url_for(theme.site.rss.path | default('/atom.xml')) }}" />
    {% endif %}

    <!-- CSS -->
    {% if is_post() or is_page() %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightgallery@2.9.0/css/lightgallery.min.css" />
    {% endif %}
    <link rel="stylesheet" href="{{ url_for('css/style.min.css') }}">
</head>
