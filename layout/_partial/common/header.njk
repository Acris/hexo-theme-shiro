{% from "_macro/ui.njk" import seal, icon_rss, icon_search, icon_chevron_down, icon_theme_system, icon_theme_light, icon_theme_dark with context %}
{% set rss_config = site_config.rss or {} %}
<header class="relative" data-pagefind-ignore>

    <div class="relative flex items-start justify-center">
        <div class="text-center">
            <div class="relative inline-block">
                {% if is_home() %}
                <h1 class="site-title">
                    <a href="{{ html_attr(url_for('/')) | safe }}">{{ html_attr(config.title | default("白夜書簡", true)) | safe }}</a>
                </h1>
                {% else %}
                <p class="site-title">
                    <a href="{{ html_attr(url_for('/')) | safe }}">{{ html_attr(config.title | default("白夜書簡", true)) | safe }}</a>
                </p>
                {% endif %}
                <!-- Seal: Mathematically Centered -->
                {% if site_seal_enabled %}
                <div
                    class="absolute left-full top-1/2 -translate-y-1/2 ml-1 sm:ml-4 origin-left scale-75 sm:scale-110">
                    {{ seal(site_config.seal_text | default("白", true)) }}
                </div>
                {% endif %}
            </div>
            {% if config.subtitle %}
            <p class="site-subtitle">
                {{ html_attr(config.subtitle) | safe }}
            </p>
            {% endif %}
            <div class="mt-3 sm:mt-4 flex justify-center gap-2">
                {% if rss_config.enabled %}
                <a class="header-pill-btn"
                    href="{{ html_attr(safe_resource_url_for(rss_config.path | default('/atom.xml'), '/atom.xml')) | safe }}" target="_blank" rel="noopener" aria-label="RSS">
                    {{ icon_rss() }}
                </a>
                {% endif %}
                {% if dark_mode_toggle %}
                <button id="themeToggle" type="button" class="header-pill-btn" aria-label="{{ html_attr(__('theme.' + dark_mode_default)) | safe }}" data-label-system="{{ html_attr(__('theme.system')) | safe }}" data-label-light="{{ html_attr(__('theme.light')) | safe }}" data-label-dark="{{ html_attr(__('theme.dark')) | safe }}">
                    {{ icon_theme_system() }}
                    {{ icon_theme_light() }}
                    {{ icon_theme_dark() }}
                </button>
                {% endif %}
                {% if search_enabled %}
                <button id="searchToggle" type="button" class="header-pill-btn" aria-label="{{ html_attr(__('search.button')) | safe }}">
                    {{ icon_search() }}
                </button>
                {% endif %}
            </div>
        </div>
    </div>
</header>

<!-- Navigation -->
{% if menu_items.length %}
<nav class="mt-8 md:mt-10" aria-label="{{ html_attr(__('nav.menu')) | safe }}" data-pagefind-ignore>
    <!-- Mobile Toggle -->
    <div class="flex items-center justify-center md:hidden">
        <button id="menuBtn" type="button"
            class="focus-elegant inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-paper/95 px-4 py-2 text-sm text-slate-700 shadow-xs"
            aria-expanded="false" aria-controls="mobileMenu">
            <span class="text-base leading-none tracking-widest">{{ html_attr(__('nav.menu')) | safe }}</span>
            {{ icon_chevron_down(id="menuChevron") }}
        </button>
    </div>

    <!-- Desktop Menu -->
    <div class="hidden md:block">
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-base text-slate-700 px-4">
            {% for item in menu_items %}
            {% set item_url = safe_url_for(item.url) %}
            {% set item_target = link_target(item.target) %}
            <li><a class="focus-elegant rounded-md px-2 py-1 hover:text-seal transition-colors"
                    href="{{ html_attr(item_url) | safe }}" {% if item_target %}target="{{ html_attr(item_target) | safe }}"{% if is_blank_target(item_target) %} rel="noopener noreferrer"{% endif %}{% endif %}>{{ html_attr(item.name) | safe }}</a></li>
            {% if not loop.last %}
            <li class="text-slate-400 select-none" role="separator" aria-hidden="true">/</li>
            {% endif %}
            {% endfor %}
        </ul>
    </div>

    <!-- Mobile Menu Panel -->
    <div id="mobileMenu" class="menu-panel md:hidden mt-4" data-open="false">
        <ul
            class="mx-auto max-w-sm max-h-menu overflow-y-auto rounded-2xl border border-slate-200 bg-paper/95 shadow-xs">
            {% for item in menu_items %}
            {% set item_url = safe_url_for(item.url) %}
            {% set item_target = link_target(item.target) %}
            <li><a class="focus-elegant block px-6 py-3 text-center text-slate-800 hover:text-seal hover:bg-seal/5 transition-colors"
                    href="{{ html_attr(item_url) | safe }}" {% if item_target %}target="{{ html_attr(item_target) | safe }}"{% if is_blank_target(item_target) %} rel="noopener noreferrer"{% endif %}{% endif %}>{{ html_attr(item.name) | safe }}</a></li>
            {% if not loop.last %}
            <li class="h-px bg-slate-200/70" role="separator" aria-hidden="true"></li>
            {% endif %}
            {% endfor %}
        </ul>
    </div>
</nav>
{% endif %}
