{% from "_macro/ui.njk" import seal, icon_rss, icon_search, icon_chevron_down, icon_theme_system, icon_theme_light, icon_theme_dark, menu_link with context %}
{% set site_config = gates.siteConfig %}
{% set menu_items = gates.menuItems %}
<header class="relative" data-pagefind-ignore>

    <div class="relative flex items-start justify-center">
        <div class="text-center">
            <div class="relative inline-block">
                {% if is_home() %}
                <h1 class="site-title">
                    <a href="{{ href_for('/') }}">{{ escape_html(config.title | default("白夜書簡", true)) }}</a>
                </h1>
                {% else %}
                <p class="site-title">
                    <a href="{{ href_for('/') }}">{{ escape_html(config.title | default("白夜書簡", true)) }}</a>
                </p>
                {% endif %}
                <!-- Seal: Mathematically Centered -->
                {% if gates.siteSealEnabled %}
                <div
                    class="absolute left-full top-1/2 -translate-y-1/2 ml-1 sm:ml-4 origin-left scale-75 sm:scale-110">
                    {{ seal(site_config.seal_text | default("白", true)) }}
                </div>
                {% endif %}
            </div>
            {% if config.subtitle %}
            <p class="site-subtitle">
                {{ escape_html(config.subtitle) }}
            </p>
            {% endif %}
            {% set has_header_actions = gates.needsRss or gates.darkModeToggle or gates.searchEnabled %}
            {% if has_header_actions %}
            <div class="mt-3 sm:mt-4 flex items-center justify-center gap-2">
                {% if gates.needsRss %}
                <a class="focus-elegant header-pill-btn"
                    href="{{ attr_url(safe_resource_url_for(gates.rssPath, '/atom.xml')) }}" target="_blank" rel="noopener noreferrer" aria-label="{{ escape_attr(__('common.rss')) }}">
                    {{ icon_rss() }}
                </a>
                {% endif %}
                {% if gates.darkModeToggle %}
                <button id="themeToggle" type="button" class="focus-elegant header-pill-btn" aria-label="{{ escape_attr(__('theme.' + gates.darkModeDefault)) }}" data-label-system="{{ escape_attr(__('theme.system')) }}" data-label-light="{{ escape_attr(__('theme.light')) }}" data-label-dark="{{ escape_attr(__('theme.dark')) }}">
                    {{ icon_theme_system() }}
                    {{ icon_theme_light() }}
                    {{ icon_theme_dark() }}
                </button>
                {% endif %}
                {% if gates.searchEnabled %}
                {# Header pill; search-bootstrap opens pagefind-modal (dialog id=shiroSearchDialog). #}
                <button id="searchToggle" type="button" class="focus-elegant header-pill-btn" aria-haspopup="dialog" aria-controls="shiroSearchDialog" aria-expanded="false" aria-label="{{ escape_attr(__('search.trigger')) }}">
                    {{ icon_search() }}
                </button>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </div>
</header>

<!-- Navigation -->
{% if menu_items.length %}
<nav class="mt-8 md:mt-10" aria-label="{{ escape_attr(__('nav.menu')) }}" data-pagefind-ignore>
    <!-- Mobile Toggle -->
    <div class="flex items-center justify-center md:hidden">
        <button id="menuBtn" type="button"
            class="focus-elegant inline-flex cursor-pointer items-center gap-2 rounded-full border border-border-strong bg-paper/95 px-4 py-2 text-sm text-text-body shadow-xs"
            aria-expanded="false" aria-controls="mobileMenu" hidden>
            <span class="text-base leading-none tracking-widest">{{ escape_html(__('nav.menu')) }}</span>
            {{ icon_chevron_down(id="menuChevron") }}
        </button>
    </div>

    <!-- Desktop Menu -->
    <div class="hidden md:block">
        <ul class="nav-desktop flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-base text-text-body px-4">
            {% for item in menu_items %}
            <li>{{ menu_link(item, "nav-desktop-link focus-elegant rounded-md px-2 py-1 hover:text-seal transition-colors") }}</li>
            {% if not loop.last %}
            <li class="text-text-subtle select-none" role="separator" aria-hidden="true">/</li>
            {% endif %}
            {% endfor %}
        </ul>
    </div>

    <!-- Mobile Menu Panel: open without JS (progressive enhancement); html.js collapses until toggled. -->
    <div id="mobileMenu" class="menu-panel md:hidden mt-4" data-open="false">
        <ul
            class="mx-auto max-w-sm max-h-menu overflow-y-auto rounded-2xl border border-border-strong bg-paper/95 shadow-xs">
            {% for item in menu_items %}
            <li>{{ menu_link(item, "focus-elegant block px-6 py-3 text-center text-text-body hover:text-seal hover:bg-seal/5 transition-colors") }}</li>
            {% if not loop.last %}
            <li class="h-px bg-border-decorative" role="separator" aria-hidden="true"></li>
            {% endif %}
            {% endfor %}
        </ul>
    </div>
</nav>
{% endif %}
