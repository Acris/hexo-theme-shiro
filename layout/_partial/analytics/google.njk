{% set analytics_config = theme.analytics or {} %}
{% set google_analytics = analytics_config.google or {} %}
{% if google_analytics.enabled and google_analytics.id %}
  <!-- Google tag (gtag.js) — SRI omitted because Google updates this script frequently,
       which would break integrity checks. Use CSP script-src instead for protection. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ html_attr(url_query(google_analytics.id)) | safe }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', {{ google_analytics.id | dump | safe }});
  </script>
{% endif %}
