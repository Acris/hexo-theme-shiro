{% if theme.analytics.google.enabled and theme.analytics.google.id %}
  <!-- Google tag (gtag.js) -->
  <!-- The async script downloads gtag.js in parallel. The inline script below
       executes synchronously before the async script finishes, initializing
       dataLayer and gtag() so they are ready when gtag.js loads. Do not reorder. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ theme.analytics.google.id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', '{{ theme.analytics.google.id }}');
  </script>
{% endif %}
