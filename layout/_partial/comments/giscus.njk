{% set comments_config = theme.comments or {} %}
{% set giscus_config = giscus if giscus is defined else (comments_config.giscus or {}) %}
{% set giscus_src = giscus_config.src or '' %}
{% set giscus_repo = giscus_config.repo or '' %}
{% set giscus_repo_id = giscus_config.repo_id or '' %}
{% set giscus_category = giscus_config.category or '' %}
{% set giscus_category_id = giscus_config.category_id or '' %}
{% set giscus_mapping = giscus_config.mapping or 'pathname' %}
{% set giscus_term = giscus_config.term %}
{% set giscus_strict = giscus_config.strict | default('0') %}
{% set giscus_reactions_enabled = giscus_config.reactions_enabled | default('1') %}
{% set giscus_emit_metadata = giscus_config.emit_metadata | default('0') %}
{% set giscus_input_position = giscus_config.input_position or 'bottom' %}
{% set giscus_theme = giscus_config.theme or 'preferred_color_scheme' %}
{% set giscus_lang = giscus_config.lang or 'en' %}
<div id="giscus-container" class="giscus" data-pagefind-ignore></div>
<script>
;(() => {
    const d = document, w = window;
    const container = d.getElementById('giscus-container');
    if (!container) return;

    const loadCommentsCss = w.__shiroLoadCommentsCss || (() => Promise.resolve());
    let loaded = false;

    const loadGiscus = () => {
        if (loaded) return;
        loaded = true;

        const binaryAttr = (value, fallback) => {
            if (value === true) return '1';
            if (value === false) return '0';
            const text = String(value == null ? fallback : value).trim().toLowerCase();
            if (text === 'true') return '1';
            if (text === 'false') return '0';
            return text || fallback;
        };
        const safeScriptSrc = (value, fallback) => {
            const text = String(value || '').trim();
            if (!text) return fallback;
            if (/[\u0000-\u001F\u007F]/.test(text)) return fallback;
            if (/^https?:\/\//i.test(text) || /^\/\//.test(text)) return text;
            return /^[a-z][a-z0-9+.-]*:/i.test(text) ? fallback : text;
        };

        const s = d.createElement('script');
        s.src = safeScriptSrc({{ js_value(giscus_src) | safe }}, 'https://giscus.app/client.js');
        s.async = true;
        s.crossOrigin = 'anonymous';
        const attrs = {
            'data-repo': {{ js_value(giscus_repo) | safe }},
            'data-repo-id': {{ js_value(giscus_repo_id) | safe }},
            'data-category': {{ js_value(giscus_category) | safe }},
            'data-category-id': {{ js_value(giscus_category_id) | safe }},
            'data-mapping': {{ js_value(giscus_mapping) | safe }},
            {%- if giscus_term %}
            'data-term': {{ js_value(giscus_term) | safe }},
            {%- endif %}
            'data-strict': binaryAttr({{ js_value(giscus_strict) | safe }}, '0'),
            'data-reactions-enabled': binaryAttr({{ js_value(giscus_reactions_enabled) | safe }}, '1'),
            'data-emit-metadata': binaryAttr({{ js_value(giscus_emit_metadata) | safe }}, '0'),
            'data-input-position': {{ js_value(giscus_input_position) | safe }},
            {# Fallback to giscus built-in 'preferred_color_scheme' theme if user removes the theme config #}
            'data-theme': {{ js_value(giscus_theme) | safe }},
            'data-lang': {{ js_value(giscus_lang) | safe }},
            {%- if giscus_config.lazy_loading %}
            'data-loading': 'lazy',
            {%- endif %}
        };
        for (const [key, value] of Object.entries(attrs)) {
            s.setAttribute(key, value);
        }
        const appendScript = () => { container.appendChild(s); };
        loadCommentsCss().then(appendScript).catch(appendScript);
    };

    w.__shiroOnNearViewport(container, loadGiscus);
})();
</script>
