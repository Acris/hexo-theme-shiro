{% set comments_config = theme.comments or {} %}
{% set giscus_config = giscus if giscus is defined else (comments_config.giscus or {}) %}
<div id="giscus-container" class="giscus" data-pagefind-ignore></div>
<script>
;(() => {
    const d = document, w = window;
    const container = d.getElementById('giscus-container');
    if (!container) return;

    const loadCommentsCss = w.__shiroLoadCommentsCss || (() => Promise.resolve());
    let loaded = false;

    const loadGiscus = () => {
        if (loaded) return;
        loaded = true;

        const binaryAttr = (value, fallback) => {
            if (value === true) return '1';
            if (value === false) return '0';
            const text = String(value == null ? fallback : value).trim().toLowerCase();
            if (text === 'true') return '1';
            if (text === 'false') return '0';
            return text || fallback;
        };

        const s = d.createElement('script');
        s.src = {{ (giscus_config.src or 'https://giscus.app/client.js') | dump | safe }};
        s.async = true;
        s.crossOrigin = 'anonymous';
        const attrs = {
            'data-repo': {{ (giscus_config.repo or '') | dump | safe }},
            'data-repo-id': {{ (giscus_config.repo_id or '') | dump | safe }},
            'data-category': {{ (giscus_config.category or '') | dump | safe }},
            'data-category-id': {{ (giscus_config.category_id or '') | dump | safe }},
            'data-mapping': {{ (giscus_config.mapping or 'pathname') | dump | safe }},
            {%- if giscus_config.term %}
            'data-term': {{ giscus_config.term | dump | safe }},
            {%- endif %}
            'data-strict': binaryAttr({{ giscus_config.strict | default('0') | dump | safe }}, '0'),
            'data-reactions-enabled': binaryAttr({{ giscus_config.reactions_enabled | default('1') | dump | safe }}, '1'),
            'data-emit-metadata': binaryAttr({{ giscus_config.emit_metadata | default('0') | dump | safe }}, '0'),
            'data-input-position': {{ (giscus_config.input_position or 'bottom') | dump | safe }},
            {# Fallback to giscus built-in 'preferred_color_scheme' theme if user removes the theme config #}
            'data-theme': {{ (giscus_config.theme or 'preferred_color_scheme') | dump | safe }},
            'data-lang': {{ (giscus_config.lang or 'en') | dump | safe }},
            {%- if giscus_config.lazy_loading %}
            'data-loading': 'lazy',
            {%- endif %}
        };
        for (const [key, value] of Object.entries(attrs)) {
            s.setAttribute(key, value);
        }
        const appendScript = () => { container.appendChild(s); };
        loadCommentsCss().then(appendScript).catch(appendScript);
    };

    w.__shiroOnNearViewport(container, loadGiscus);
})();
</script>
