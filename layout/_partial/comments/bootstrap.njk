<script>
;(() => {
    window.__shiroCommentsCss = {{ versioned_url('css/comments.min.css') | dump | safe }};
    const loadStylesheet = (href, selector, dataAttr, stateKey) => {
        const d = document;
        const assetTimeout = 12000;
        if (!href) return Promise.resolve();
        if (window[stateKey]) return window[stateKey];

        const waitForStylesheet = (link) => {
            if (link.dataset.shiroLoaded === 'true' || link.sheet) {
                link.dataset.shiroLoaded = 'true';
                return Promise.resolve();
            }
            if (link.dataset.shiroError === 'true') {
                link.remove();
                return null;
            }

            return new Promise((resolve, reject) => {
                const timer = setTimeout(() => {
                    link.dataset.shiroError = 'true';
                    link.remove();
                    reject(new Error('Stylesheet load timed out'));
                }, assetTimeout);
                link.addEventListener('load', () => {
                    clearTimeout(timer);
                    link.dataset.shiroLoaded = 'true';
                    delete link.dataset.shiroError;
                    resolve();
                }, { once: true });
                link.addEventListener('error', (event) => {
                    clearTimeout(timer);
                    link.dataset.shiroError = 'true';
                    link.remove();
                    reject(event);
                }, { once: true });
            });
        };

        const createStylesheet = () => new Promise((resolve, reject) => {
            const link = d.createElement('link');
            const timer = setTimeout(() => {
                link.dataset.shiroError = 'true';
                link.remove();
                reject(new Error('Stylesheet load timed out'));
            }, assetTimeout);
            link.rel = 'stylesheet';
            link.href = href;
            link.setAttribute(dataAttr, 'true');
            link.onload = () => {
                clearTimeout(timer);
                link.dataset.shiroLoaded = 'true';
                delete link.dataset.shiroError;
                resolve();
            };
            link.onerror = (event) => {
                clearTimeout(timer);
                link.dataset.shiroError = 'true';
                link.remove();
                reject(event);
            };
            d.head.appendChild(link);
        });

        const existing = d.querySelector(selector);
        const waiting = existing ? waitForStylesheet(existing) : null;
        window[stateKey] = (waiting || createStylesheet()).catch((error) => {
            window[stateKey] = null;
            throw error;
        });
        return window[stateKey];
    };

    window.__shiroLoadCommentsCss = window.__shiroLoadCommentsCss || (() =>
        loadStylesheet(
            window.__shiroCommentsCss,
            'link[data-shiro-comments-css]',
            'data-shiro-comments-css',
            '__shiroCommentsCssLoading'
        ));

    window.__shiroOnNearViewport = window.__shiroOnNearViewport || ((element, callback, options) => {
        const w = window;
        if (!element || typeof callback !== 'function') return;
        if (!('IntersectionObserver' in w)) {
            callback();
            return;
        }
        const io = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            callback();
            io.disconnect();
        }, options || { rootMargin: '200px 0px', threshold: 0 });
        io.observe(element);
    });
})();
</script>
