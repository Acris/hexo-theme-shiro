{% extends "_layout.njk" %}
{% from "_macro/ui.njk" import section_title, icon_folder with context %}
{% from "_macro/archive.njk" import render_list, render_simple_list with context %}

{% block content %}
<section class="mx-auto max-w-3xl">
    {{ section_title(__('nav.categories'), page.category) }}

    {% if is_category() %}
        {# Use Hexo paginated page.posts (honours per_page), not the full category collection. #}
        {% set posts = page.posts.sort('date', -1) if page.posts else null %}
        {% if posts and posts.length > 0 %}
            {{ render_list(posts) }}
            {% include "_partial/common/pagination.njk" %}
        {% else %}
            {% include "_partial/common/empty.njk" %}
        {% endif %}
    {% else %}
        {% if site.categories.length > 0 %}
            {# Category cloud: preview only — avoid dumping every post site-wide. #}
            {% set category_preview_limit = 5 %}
            <div class="space-y-16 max-w-2xl mx-auto">
                {% for cat in site.categories.toArray() | sort(false, false, "name") %}
                <div id="{{ escape_attr('cat-' + cat.slug) }}" class="scroll-mt-24">
                    <h2 class="section-heading">
                        {{ icon_folder() }}
                        <a class="link-muted hover:text-seal" href="{{ url_for(cat.path) }}">{{ escape_html(cat.name) }}</a>
                        <span class="ml-auto text-sm font-normal text-slate-400 oldstyle-nums">{{ cat.length }}</span>
                    </h2>
                    {{ render_simple_list(cat.posts.sort('date', -1), category_preview_limit) }}
                    {% if cat.length > category_preview_limit %}
                    <p class="mt-4 text-center text-sm">
                        <a class="link-muted" href="{{ url_for(cat.path) }}">{{ __('index.read_more') }}</a>
                    </p>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        {% else %}
            {% include "_partial/common/empty.njk" %}
        {% endif %}
    {% endif %}
</section>
{% endblock %}
