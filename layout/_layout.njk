{% import "_macro/ui.njk" as ui with context %}
<!doctype html>
<html lang="{{ config.language }}" class="h-full scroll-smooth">
{% include "_partial/common/head.njk" %}

<body class="h-full fog-bg text-slate-800"{% if theme.toc.enabled %} data-toc-depth="{{ theme.toc.depth | default(3) }}" data-toc-min="{{ theme.toc.min_headings | default(3) }}"{% endif %}>
    {{ ui.svg_filters() }}

    {% if theme.progress_bar.enabled %}
    <div id="progressBar" class="progress-bar" aria-hidden="true"></div>
    {% endif %}

    <div class="min-h-full px-4 pt-14 pb-6 md:pb-5">

        <!-- Paper Card -->
        <div
            class="paper relative mx-auto w-full max-w-4xl rounded-2xl px-5 sm:px-8 md:px-12 lg:px-14 pt-10 pb-6 md:pt-12 md:pb-8">

            {% include "_partial/common/header.njk" %}

            <!-- Main Content -->
            <main class="section-divider">
                {% block content %}{% endblock %}
            </main>

            {% include "_partial/common/footer.njk" %}
        </div>

        <!-- Note Text — decorative aside, not part of main content or footer -->
        <aside class="mt-4 text-center" aria-hidden="true">
            <p class="site-note font-title text-xs sm:text-sm text-slate-400/70 tracking-note font-light select-none">
                白は、余白の名。
            </p>
        </aside>
    </div>

    {% if theme.back_to_top.enabled %}
    <button id="backToTop" class="back-to-top" data-visible="false" aria-label="{{ __('back_to_top') }}">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
        </svg>
    </button>
    {% endif %}

    <!-- Scripts -->
    {# LightGallery, clipboard: only loaded on post/page where code blocks and images exist #}
    {% if is_post() or is_page() %}
    <script defer src="https://cdn.jsdelivr.net/npm/lightgallery@2.9.0/lightgallery.min.js"></script>
    <script defer src="{{ url_for('js/lightgallery.js') }}"></script>
    <script defer src="{{ url_for('js/clipboard.js') }}"></script>
    {% endif %}
    {% if theme.toc.enabled %}
    <script defer src="{{ url_for('js/toc.js') }}"></script>
    {% endif %}
    {% if theme.progress_bar.enabled or theme.back_to_top.enabled %}
    <script defer src="{{ url_for('js/progress.js') }}"></script>
    {% endif %}
    {% if theme.dark_mode.toggle !== false %}
    <script defer src="{{ url_for('js/theme-toggle.js') }}"></script>
    {% endif %}
    <script defer src="{{ url_for('js/main.js') }}"></script>
    {% include "_partial/analytics/google.njk" %}
</body>
</html>
