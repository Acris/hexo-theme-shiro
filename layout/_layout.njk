{% import "_macro/ui.njk" as ui %}
<!doctype html>
<html lang="{{ config.language }}" class="h-full scroll-smooth">
{% include "_partial/common/head.njk" %}

<body class="h-full fog-bg text-slate-800"{% if theme.toc.enabled %} data-toc-depth="{{ theme.toc.depth | default(3) }}" data-toc-min="{{ theme.toc.min_headings | default(3) }}"{% endif %}>
    {{ ui.svg_filters() }}

    <div class="min-h-full px-4 pt-14 pb-6 md:pb-5">

        <!-- Paper Card -->
        <div
            class="paper mx-auto w-full max-w-4xl rounded-2xl px-5 sm:px-8 md:px-12 lg:px-14 pt-10 pb-6 md:pt-12 md:pb-8">

            {% include "_partial/common/header.njk" %}

            <!-- Main Content -->
            <main class="section-divider">
                {% block content %}{% endblock %}
            </main>

            {% include "_partial/common/footer.njk" %}
        </div>

        <!-- Note Text -->
        <div class="mt-4 text-center">
            <p class="font-title text-xs sm:text-sm text-slate-400/70 tracking-note font-light select-none">
                白は、余白の名。
            </p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.8.3/lightgallery.min.js" integrity="sha512-n02TbYimj64qb98ed5WwkNiSw/i9Xlvv4Ehvhg0jLp3qMAMWCYUHbOMbppZ0vimtyiyw9NqNqxUZC4hq86f4aQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="{{ url_for('js/lightgallery.js') }}"></script>
    <script src="{{ url_for('js/clipboard.js') }}"></script>
    {% if theme.toc.enabled %}
    <script src="{{ url_for('js/toc.js') }}"></script>
    {% endif %}
    <script src="{{ url_for('js/main.js') }}"></script>
</body>
</html>
