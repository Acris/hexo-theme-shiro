{% from "_macro/ui.njk" import svg_filters, feature_script %}
<!doctype html>
<html lang="{% if config.language is iterable and config.language is not string %}{{ config.language[0] }}{% else %}{{ config.language }}{% endif %}" class="h-full scroll-smooth">
{% include "_partial/common/head.njk" %}

<body class="h-full fog-bg text-slate-800">
    {% if theme.site.seal %}
    {{ svg_filters() }}
    {% endif %}

    {% set needs_progress_bar = theme.progress_bar.enabled and is_post() %}
    {% set needs_back_to_top = theme.back_to_top.enabled and (is_home() or (is_post() and page_looks_long(page))) %}

    {% if needs_progress_bar %}
    <div id="progressBar" class="progress-bar" aria-hidden="true"></div>
    {% endif %}
    {% if needs_back_to_top %}
    <div id="backToTopSentinel" class="back-to-top-sentinel" aria-hidden="true"></div>
    {% endif %}

    <div class="min-h-full px-4 pt-14 pb-6 md:pb-5">

        <!-- Paper Card -->
        <div
            class="paper relative mx-auto w-full max-w-4xl rounded-xl px-5 sm:px-8 md:px-12 lg:px-14 pt-10 pb-6 md:pt-12 md:pb-8">

            {% include "_partial/common/header.njk" %}

            <!-- Main Content -->
            <main class="section-divider">
                {% block content %}{% endblock %}
            </main>

            {% include "_partial/common/footer.njk" %}
        </div>

        <!-- Note Text — decorative aside, not part of main content or footer -->
        <aside class="mt-4 text-center" aria-hidden="true" role="presentation">
            <p class="site-note font-title text-xs sm:text-sm text-slate-400/70 tracking-note font-light select-none" lang="ja">
                白は、余白の名。
            </p>
        </aside>
    </div>

    {% if needs_back_to_top %}
    <button id="backToTop" class="back-to-top" data-visible="false" aria-label="{{ __('back_to_top') }}">
        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
        </svg>
    </button>
    {% endif %}

    {% if theme.search.enabled %}
    {% set search_i18n = {
        button: __('search.button'),
        placeholder: __('search.placeholder'),
        close: __('search.close'),
        zero_results: __('search.zero_results'),
        one_result: __('search.one_result'),
        many_results: __('search.many_results'),
        loading: __('search.loading')
    } %}
    {{ feature_script({ search: search_i18n }, {
        __pagefindBase: url_for('/pagefind/'),
        __searchCss: versioned_url('css/search.min.css'),
        __searchScript: versioned_url('js/search.min.js')
    }) }}
    <script defer src="{{ versioned_url('js/search-bootstrap.min.js') }}"></script>
    {% endif %}

    <!-- Scripts -->
    {% set needs_lightgallery = (is_post() or is_page()) and has_images(page) %}
    {% if needs_lightgallery %}
    {{ feature_script({
        gallery_visit_source: __('gallery_visit_source'),
        gallery_view_image: __('gallery_view_image')
    }, {
        __lightgalleryThemeCss: versioned_url('css/lightgallery.min.css'),
        __lightgalleryScript: versioned_url('js/lightgallery.min.js')
    }) }}
    <script defer src="{{ versioned_url('js/lightgallery-bootstrap.min.js') }}"></script>
    {% endif %}
    {% set needs_clipboard = page_has_code(page, theme) %}
    {% if needs_clipboard %}
    {{ feature_script({
        clipboard_copy: __('clipboard_copy'),
        clipboard_copied: __('clipboard_copied')
    }, {
        __clipboardScript: versioned_url('js/clipboard.min.js')
    }) }}
    <script defer src="{{ versioned_url('js/clipboard-bootstrap.min.js') }}"></script>
    {% endif %}
    {% set needs_toc = theme.toc.enabled and (is_post() or is_page()) and should_render_toc(page, theme.toc) %}
    {% if needs_toc %}
    <script defer src="{{ versioned_url('js/toc.min.js') }}"></script>
    {% endif %}
    {% if needs_progress_bar %}
    <script defer src="{{ versioned_url('js/progress.min.js') }}"></script>
    {% endif %}
    {% if needs_back_to_top %}
    <script defer src="{{ versioned_url('js/back-to-top.min.js') }}"></script>
    {% endif %}
    {% if theme.dark_mode.toggle != false %}
    <script defer src="{{ versioned_url('js/theme-toggle.min.js') }}"></script>
    {% endif %}
    {% if theme.menu and theme.menu.length %}
    <script>window.__mobileMenuScript="{{ versioned_url('js/mobile-menu.min.js') }}";</script>
    <script defer src="{{ versioned_url('js/mobile-menu-bootstrap.min.js') }}"></script>
    {% endif %}

    {% include "_partial/analytics/google.njk" %}
</body>
</html>
